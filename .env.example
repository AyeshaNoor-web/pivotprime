# Copy to .env.local and fill in. Never commit real values: .env* is gitignored.

# STAGE ONE
# ---------

# Transactional email for the contact form. Delivers to hello@pivotprime.ae
# with reply-to set to the submitter, plus a short autoresponder.
RESEND_API_KEY=

# Absolute site origin, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://pivotprime.ae

# The WhatsApp business number in international format, digits only, no plus.
# Used by the floating button and every inline WhatsApp call to action. When
# unset, those CTAs fall back to /contact rather than producing a broken
# wa.me link.
NEXT_PUBLIC_WHATSAPP_NUMBER=971524401075

# LATER PHASE
# -----------

# Stage one ships the site only. The diagnostic, its report, the email delivery
# of that report and the database are a later phase. While this is false,
# /diagnostic returns a 404, carries noindex and nofollow, and is excluded from
# the sitemap. The work is preserved, not reverted: see the
# feature/diagnostic-phase-2 branch.
#
# CHANGING THIS REQUIRES A REBUILD, NOT A RESTART.
# NEXT_PUBLIC_ variables are inlined into the bundle at build time, so
# restarting the server with a new value changes nothing. Run `npm run build`
# again, or trigger a fresh deploy, after flipping it.
NEXT_PUBLIC_ENABLE_DIAGNOSTIC=false

# Persistence for diagnostic submissions. Not used in stage one, which stores
# nothing. The service role key is server-only, never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the unlisted deep diagnostic. Later phase.
DIAGNOSTIC_DEEP_TOKEN=
