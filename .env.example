# Copy to .env.local and fill in. Never commit real values: .env* is gitignored.

# Transactional email (enquiry, diagnostic report, insights signup).
# All three send from and reply to hello@pivotprime.ae.
RESEND_API_KEY=

# Persistence for diagnostic submissions and enquiries.
# The service role key is server-only. Never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin, used for canonical URLs, Open Graph tags and sitemap.
NEXT_PUBLIC_SITE_URL=https://pivotprime.ae

# Gate for the diagnostic API. The diagnostic captures an email address and
# returns a report, which is personal data processing under the UAE PDPL, so
# it stays off until /privacy carries client-approved text and the consent
# checkbox is live. See spec section 2.7.
DIAGNOSTIC_API_ENABLED=false

# Shared secret for /diagnostic/deep. The deep instrument is unlisted and
# reachable only by a link carrying this token as ?k=
DIAGNOSTIC_DEEP_TOKEN=
